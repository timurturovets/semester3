<Window x:Class="SummationApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SummationApp.Views"
        xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
        mc:Ignorable="d"
        Title="Задача 13" Height="600" Width="1200">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
            <Label Content="n:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding N}" Width="50" Margin="0,0,10,0"/>
            
            <Label Content="p:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding P}" Width="50" Margin="0,0,10,0"/>
            
            <Button Content="Обновить" Command="{Binding UpdateCommand}" Width="80" Margin="10,0,0,0"/>
        </StackPanel>
        
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Результаты:" FontWeight="Bold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Прямой метод: " Width="120"/>
                <TextBlock Text="{Binding DirectResult, StringFormat=F4}"/>
                <TextBlock Text=" (операций: " Margin="10,0,0,0"/>
                <TextBlock Text="{Binding DirectOperations}"/>
                <TextBlock Text=")"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Асимптотический метод: " Width="120"/>
                <TextBlock Text="{Binding AsymptoticResult, StringFormat=F4}"/>
                <TextBlock Text=" (операций: " Margin="10,0,0,0"/>
                <TextBlock Text="{Binding AsymptoticOperations}"/>
                <TextBlock Text=")"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Точный метод: " Width="120"/>
                <TextBlock Text="{Binding ExactResult, StringFormat=F4}"/>
                <TextBlock Text=" (операций: " Margin="10,0,0,0"/>
                <TextBlock Text="{Binding ExactOperations}"/>
                <TextBlock Text=")"/>
            </StackPanel>
        </StackPanel>
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <oxy:PlotView Model="{Binding OperationsVsNPlot}" Grid.Column="0"/>
            <oxy:PlotView Model="{Binding OperationsVsPPlot}" Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>